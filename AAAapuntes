Recorrer nodos
Bucle por todos los nodos
<xsl:for-each
 select="
//alumno
">
Solo los que cumplan condición
<xsl:for-each
 select="
//alumno[grupo='DAW2']
">
Delegar a template propio
<xsl:apply-templates
 select="
//alumno
"/>
Template que recibe los nodos
<xsl:template
 match="
alumno
"> ... 
</xsl:template>



Ordenar
Por nota, mayor a menor
<xsl:sort
 select="
nota
" data-type="
number
" order="
descending
"/>
Por texto alfabético
<xsl:sort
 select="
nombre
" data-type="
text
" order="
ascending
"/>
Va dentro de <xsl:apply-templates> o <xsl:for-each>, antes del contenido



